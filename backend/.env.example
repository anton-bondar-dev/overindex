# Copy to .env and fill in your OWN keys. NEVER commit the real .env.

# --- Qloo Taste AI ---
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
USE_MOCK_QLOO=0            # set to 1 to run the whole pipeline on synthetic data (no key)

# --- LLM provider: "groq" (primary — fast from any IP) or "gemini" ---
LLM_PROVIDER=groq

# --- Groq (console.groq.com, OpenAI-compatible, free tier) ---
# One or more keys, comma-separated. NB: the free tier is per-account, so extra
# keys add rate headroom, not daily quota.
GROQ_API_KEYS=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# --- Gemini (Google AI Studio) — fallback provider (set LLM_PROVIDER=gemini) ---
# NB: heavily throttled from datacenter IPs; fine from a residential network.
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.8-flash
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_THINKING_BUDGET=0   # applied only to non-"lite" thinking models

# --- CORS: your deployed origin (the frontend is same-origin; avoid "*") ---
ALLOWED_ORIGINS=https://overindex.overpro.fit
