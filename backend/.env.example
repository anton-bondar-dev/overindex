# Copy to .env and fill in your OWN keys. NEVER commit the real .env.

# --- Qloo Taste AI ---
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
USE_MOCK_QLOO=0            # set to 1 to run the whole pipeline on synthetic data (no key)

# --- Gemini (Google AI Studio, free tier) ---
# One or more keys, comma-separated — the agent rotates across them on rate limits.
GEMINI_API_KEYS=
# Models tried in order; falls through to the next on overload (503).
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.8-flash
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_THINKING_BUDGET=0   # applied only to non-"lite" thinking models

# --- CORS (tighten to your demo origin in production) ---
ALLOWED_ORIGINS=*
