# Copy to .env and fill in your OWN keys. NEVER commit the real .env.

# --- Qloo Taste AI ---
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
USE_MOCK_QLOO=0            # set to 1 to run the whole pipeline on synthetic data (no key)

# --- Groq (console.groq.com, OpenAI-compatible, free tier) ---
# One or more keys, comma-separated. NB: the free tier is per-account, so extra
# keys from the SAME account add no quota; a second account does.
GROQ_API_KEYS=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# --- CORS: your deployed origin (the frontend is same-origin; avoid "*") ---
ALLOWED_ORIGINS=https://overindex.overpro.fit
